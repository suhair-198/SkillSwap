# SkillSwap Backend Environment Variables Example
# Copy this to .env for backend configuration

# Server Port
PORT=8080

# Active Spring Profile:
# - 'default' : Local persistent H2 database (zero configuration, runs immediately at ./data/skillswapdb.mv.db)
# - 'supabase': Remote Supabase PostgreSQL database
SPRING_PROFILES_ACTIVE=default

# Supabase / PostgreSQL Configuration (Used when SPRING_PROFILES_ACTIVE=supabase)
# Uses IPv4 Connection Pooler (Region: ap-northeast-2 Seoul)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.YOUR_PROJECT_REF
SPRING_DATASOURCE_PASSWORD=YOUR_SUPABASE_PASSWORD
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Security Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000
